{
  "name": "pulsoicon-preact",
  "version": "6.2.0",
  "description": "9955 animated Preact icons, each with its own hand-written motion. The same icons, props and motion as pulsoicon-react.",
  "type": "module",
  "sideEffects": false,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityPulso/PulsoIcon-Package.git",
    "directory": "packages/preact"
  },
  "homepage": "https://pulsoicon.com",
  "bugs": {
    "url": "https://github.com/CityPulso/PulsoIcon-Package/issues"
  },
  "keywords": [
    "icons",
    "animated-icons",
    "preact",
    "lucide",
    "motion",
    "svg"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/pack-files.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pulsoicon-core": "6.2.0"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "preact": ">=10.11.0"
  },
  "author": "CityPulso",
  "devDependencies": {
    "preact-render-to-string": "^6.8.3"
  }
}
