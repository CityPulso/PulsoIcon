{
  "name": "pulsoicon-svelte",
  "version": "6.0.0",
  "description": "9955 animated Svelte icons, each with its own hand-written motion. The same icons, props and motion as pulsoicon-react.",
  "type": "module",
  "sideEffects": false,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityPulso/PulsoIcon.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/CityPulso/PulsoIcon#readme",
  "bugs": {
    "url": "https://github.com/CityPulso/PulsoIcon/issues"
  },
  "keywords": [
    "icons",
    "animated-icons",
    "svelte",
    "lucide",
    "motion",
    "svg"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "svelte": "./dist/all.js",
      "default": "./dist/all.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte",
      "default": "./dist/icons/*.svelte"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist",
    "prepack": "node ../../scripts/pack-files.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.check.json --threshold error",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pulsoicon-core": "6.0.0"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "svelte": ">=5.20.0"
  },
  "author": "CityPulso",
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3"
  }
}
