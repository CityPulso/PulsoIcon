{
  "name": "pulsoicon",
  "version": "5.2.1",
  "description": "9955 animated React icons, each with its own hand-written motion. Drop-in replacement for lucide-react.",
  "type": "module",
  "sideEffects": false,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityPulso/PulsoIcon.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/CityPulso/PulsoIcon#readme",
  "bugs": {
    "url": "https://github.com/CityPulso/PulsoIcon/issues"
  },
  "keywords": [
    "icons",
    "animated-icons",
    "react",
    "lucide",
    "tabler",
    "iconoir",
    "phosphor",
    "simple-icons",
    "motion",
    "svg",
    "brand-icons"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/pack-files.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pulsoicon-core": "5.2.1"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "author": "CityPulso"
}
