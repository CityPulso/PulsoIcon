{
  "name": "pulsoicon-workspace",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "description": "PulsoIcon for every platform. The version here is the release version of every package (npm, Maven, SwiftPM tag).",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/vue",
    "packages/svelte"
  ],
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "gen:check": "tsx scripts/gen.ts --check",
    "set-version": "tsx scripts/version.ts",
    "version:check": "tsx scripts/version.ts --check",
    "build": "npm run gen && npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "test:browser": "node tests/browser/motion-parity.mjs",
    "preview:react": "vite --config preview/react/vite.config.ts",
    "preview:vue": "vite --config preview/vue/vite.config.ts",
    "preview:svelte": "vite --config preview/svelte/vite.config.ts",
    "prettier": "prettier --write \"{packages/core/src,packages/*/tests,packages/react/src/runtime,preview,scripts,tests}/**/*.{ts,tsx,mjs,css,html}\" packages/vue/src/createIcon.ts \"preview/**/*.vue\"",
    "import-solid": "tsx .scripts/import-solid.ts && npm run prettier"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@phosphor-icons/core": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons": "^3.50.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "motion": "^14.9.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "author": "CityPulso"
}
