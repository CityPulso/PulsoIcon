{
  "name": "pulsoicon",
  "version": "3.1.0",
  "description": "6331 animated React icons, each with its own hand-written motion. Drop-in replacement for lucide-react.",
  "type": "module",
  "sideEffects": false,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityPulso/PulsoIcon.git"
  },
  "homepage": "https://github.com/CityPulso/PulsoIcon#readme",
  "bugs": {
    "url": "https://github.com/CityPulso/PulsoIcon/issues"
  },
  "keywords": [
    "icons",
    "animated-icons",
    "react",
    "lucide",
    "tabler",
    "motion",
    "svg",
    "brand-icons"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite --config preview/vite.config.ts",
    "prettier": "prettier --write \"{src,tests,preview}/**/*.{ts,tsx,css,html}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "motion": "^14.9.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "author": "CityPulso"
}
