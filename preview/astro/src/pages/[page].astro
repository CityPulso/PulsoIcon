---
// The icons of one first letter (or part of one), rendered on the server from the generated icon components: each icon's own <script> hands its
// motion to the client player, so the page also checks that only the icons it shows are loaded.
import { fileURLToPath } from "node:url";
import { ICON_NAMES } from "pulsoicon-core/names";
import BrandCitypulso from "pulsoicon-astro/icons/brand-citypulso";

import { FRAMEWORKS, FrameworkEnum } from "../../../shared/frameworks";
import { LETTERS, partLabel as label, PARTS } from "../parts";

import "../../../shared/app.css";

type IconModule = { default: (props: Record<string, unknown>) => unknown };

export function getStaticPaths() {
  return PARTS.map((p) => ({ params: { page: p.slug } }));
}

const current = PARTS.find((p) => p.slug === Astro.params.page)!;
const { letter, names } = current;
const counts = new Map(LETTERS.map((l) => [l, ICON_NAMES.filter((n) => n.startsWith(l)).length]));
const siblings = PARTS.filter((p) => p.letter === letter);
const ICONS_DIR = fileURLToPath(new URL("../../../../packages/astro/src/icons/", import.meta.url));
// Not import.meta.glob: that puts all 9955 components in the page's module graph, and the dev server's CSS collection
// compiles every one of them on the first request (about a minute).
const icons = await Promise.all(
  names.map(async (name) => ({ name, Icon: ((await import(/* @vite-ignore */ `${ICONS_DIR}${name}.astro`)) as IconModule).default })),
);
const previous = PARTS[PARTS.indexOf(current) - 1];
const next = PARTS[PARTS.indexOf(current) + 1];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PulsoIcon · Astro</title>
  </head>
  <body>
    <div class="page" data-theme="light">
      <header class="bar">
        <div class="title">
          <h1 class="brand" data-icon-trigger title="PulsoIcon by CityPulso">
            PulsoIcon
            <BrandCitypulso class="company" size={26} />
            <!-- The CityPulso bars use the logo's orange gradient (see .company in app.css). -->
            <svg aria-hidden="true" height="0" style="position: absolute" width="0">
              <defs>
                <linearGradient gradientUnits="userSpaceOnUse" id="citypulso-orange" x1="0" x2="0" y1="14" y2="3">
                  <stop offset="0" stop-color="#e8412c"></stop>
                  <stop offset="1" stop-color="#f7941d"></stop>
                </linearGradient>
              </defs>
            </svg>
          </h1>
          <nav aria-label="Framework" class="frameworks">
            {
              FRAMEWORKS.map((f) => (
                <a aria-current={f.id === FrameworkEnum.ASTRO ? "page" : undefined} data-port={f.port} href={`http://localhost:${f.port}/`}>
                  {f.label}
                </a>
              ))
            }
          </nav>
          <p>{ICON_NAMES.length} animated icons, rendered on the server. Hover a card to play it.</p>
          <p class="warn" hidden id="reduced">Your system asks for reduced motion, so icons will not animate. Turn it off to review.</p>
        </div>
        <div class="controls">
          <input aria-label="Filter this page" class="search" id="search" placeholder={`Filter the ${label(current)} icons`} type="search" />
          <label class="range">
            Size <span id="size-value">32</span>
            <input id="size" max="96" min="16" type="range" value="32" />
          </label>
          <label class="range">
            Stroke <span id="stroke-value">2</span>
            <input id="stroke" max="3" min="1" step="0.25" type="range" value="2" />
          </label>
          <button class="button" id="play" type="button">Play visible</button>
          <button class="button" id="theme" type="button">Dark</button>
        </div>
        <nav aria-label="Pages by first letter" class="letters">
          {
            LETTERS.map((l) =>
              counts.get(l) ? (
                <a aria-pressed={l === letter ? "true" : "false"} class="letter" href={`/${l}/`} title={`${counts.get(l)} icons`}>
                  {l.toUpperCase()}
                </a>
              ) : (
                <button class="letter" disabled type="button">
                  {l.toUpperCase()}
                </button>
              ),
            )
          }
        </nav>
        <p class="hint" id="hint">Showing {names.length} starting with {label(current)}.</p>
        {
          siblings.length > 1 && (
            <nav aria-label={`Parts of ${letter.toUpperCase()}`} class="letters">
              {siblings.map((p) => (
                <a aria-pressed={p === current ? "true" : "false"} class="letter" href={`/${p.slug}/`} title={`${p.names.length} icons`}>
                  {label(p)}
                </a>
              ))}
            </nav>
          )
        }
      </header>
      <main class="grid">
        {
          icons.map(({ name, Icon }) => (
            <div class="card" data-icon-trigger data-name={name}>
              <div class="pair">
                <div class="cell" title="Outline">
                  <Icon size={32} />
                </div>
                <div class="cell" title="Solid">
                  <Icon size={32} solid />
                </div>
              </div>
              <div class="name">{name}</div>
            </div>
          ))
        }
      </main>
      <footer class="pager">
        {previous && <a class="button" href={`/${previous.slug}/`}>← {label(previous)}</a>}
        {next && <a class="button" href={`/${next.slug}/`}>{label(next)} →</a>}
      </footer>
    </div>
  </body>
</html>

<script>
  import { initialTheme, playVisible, reducedMotion, ThemeEnum } from "../../../shared/catalog";

  const page = document.querySelector<HTMLElement>(".page")!;
  const themeButton = document.querySelector<HTMLButtonElement>("#theme")!;
  const setTheme = (theme: ThemeEnum) => {
    page.dataset.theme = theme;
    themeButton.textContent = theme === ThemeEnum.DARK ? "Light" : "Dark";
  };
  setTheme(initialTheme());
  themeButton.addEventListener("click", () => setTheme(page.dataset.theme === ThemeEnum.DARK ? ThemeEnum.LIGHT : ThemeEnum.DARK));
  document.querySelector<HTMLButtonElement>("#play")!.addEventListener("click", playVisible);
  document.querySelector<HTMLElement>("#reduced")!.hidden = !reducedMotion;
  for (const a of document.querySelectorAll<HTMLAnchorElement>(".frameworks a")) a.href = `${location.protocol}//${location.hostname}:${a.dataset.port}/`;

  const cards = [...document.querySelectorAll<HTMLElement>(".card")];
  const hint = document.querySelector<HTMLElement>("#hint")!;
  document.querySelector<HTMLInputElement>("#search")!.addEventListener("input", (event) => {
    const q = (event.target as HTMLInputElement).value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      card.hidden = !!q && !card.dataset.name!.includes(q);
      if (!card.hidden) shown++;
    }
    hint.textContent = `Showing ${shown}${q ? ` matching “${q}”` : ""} on this page.`;
  });

  // The icons are drawn on the server, so the controls resize the drawn <svg>s in place.
  const svgs = () => document.querySelectorAll<SVGSVGElement>(".cell svg");
  const range = (id: string, apply: (value: string) => void) => {
    const input = document.querySelector<HTMLInputElement>(`#${id}`)!;
    input.addEventListener("input", () => {
      document.querySelector(`#${id}-value`)!.textContent = input.value;
      apply(input.value);
    });
  };
  range("size", (v) => svgs().forEach((svg) => (svg.setAttribute("width", v), svg.setAttribute("height", v))));
  range("stroke", (v) => svgs().forEach((svg) => svg.setAttribute("stroke-width", v)));
</script>
