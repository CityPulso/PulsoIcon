# Ports of the preview galleries (npm run preview). Copy to .env or .env.local and uncomment the ones to change.
# A port another program holds moves to the next free one on its own; set one here to choose where it goes.
# PULSOICON_PORT_REACT=10205
# PULSOICON_PORT_VUE=10206
# PULSOICON_PORT_SVELTE=10207
# PULSOICON_PORT_SOLID=10208
# PULSOICON_PORT_PREACT=10209
# PULSOICON_PORT_ANGULAR=10210
# PULSOICON_PORT_ASTRO=10211
